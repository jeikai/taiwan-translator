# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/translator?retryWrites=true&w=majority
# "mongo" in production. "memory" keeps everything in RAM (local dev and tests only).
DATA_STORE=mongo
# Long random string: openssl rand -base64 32
AUTH_SECRET=change-me
# Translation server from translator-server/ (e.g. https://your-name.duckdns.org)
TRANSLATE_API_URL=https://your-name.duckdns.org
TRANSLATE_API_KEY=change-me
# "remote" calls TRANSLATE_API_URL. "mock" returns fake translations (dev and tests only).
TRANSLATE_PROVIDER=remote
